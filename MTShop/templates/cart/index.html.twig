{% extends 'base.html.twig' %}

{% block title %}Mon panier | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Mon panier</h1>
            <p class="fs-5 text-secondary mb-0">Retrouvez ici les articles ajoutés à votre panier.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if items is empty %}
            <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                <p class="fs-5 mb-0 text-secondary">Votre panier est vide pour le moment.</p>
            </div>
        {% else %}
            <div class="d-grid gap-4">
                {% for item in items %}
                    <article class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                        <div class="row g-4 align-items-center">
                            <div class="col-12 col-md-4 col-lg-3">
                                {% if item.product.imageName %}
                                    <img
                                        src="{{ asset('uploads/products/' ~ item.product.imageName) }}"
                                        alt="{{ item.product.name }}"
                                        class="img-fluid rounded-4 w-100"
                                        style="object-fit: cover; height: 220px;"
                                    >
                                {% else %}
                                    <div class="rounded-4 bg-primary d-flex align-items-center justify-content-center text-white fw-bold" style="height: 220px;">
                                        Image
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-md-8 col-lg-9">
                                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                    <div>
                                        <h2 class="h3 fw-bold mb-2">{{ item.product.name }}</h2>
                                        <p class="text-secondary mb-3">{{ item.product.description }}</p>

                                        {% if item.promotion > 0 %}
                                            <span class="badge text-bg-danger mb-3">Promotion -{{ item.promotion }}%</span>
                                        {% endif %}

                                        <div class="d-flex flex-wrap align-items-center gap-3">
                                            <span class="fs-5 fw-semibold">
                                                {% if item.promotion > 0 %}
                                                    <del class="text-secondary me-2">{{ item.unitPrice|number_format(2, ',', ' ') }} €</del>
                                                {% endif %}
                                                {{ item.discountedUnitPrice|number_format(2, ',', ' ') }} €
                                            </span>
                                            <span class="text-secondary">Sous-total : {{ item.lineTotal|number_format(2, ',', ' ') }} €</span>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column align-items-lg-end gap-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <form method="post" action="{{ path('app_cart_decrease', {id: item.cart.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_decrease_' ~ item.cart.id) }}">
                                                <button type="submit" class="btn btn-danger">Retirer</button>
                                            </form>

                                            <span class="fs-5 fw-bold px-3">{{ item.quantity }}</span>

                                            <form method="post" action="{{ path('app_cart_increase', {id: item.cart.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cart_increase_' ~ item.cart.id) }}">
                                                <button type="submit" class="btn btn-primary">Ajouter</button>
                                            </form>
                                        </div>

                                        <form method="post" action="{{ path('app_cart_remove', {id: item.cart.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.cart.id) }}">
                                            <button type="submit" class="btn btn-outline-danger">Supprimer l'article</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="rounded-4 border border-2 bg-white p-4 shadow-sm mt-4" style="border-color: #0b1f3a !important;">
                <div class="row g-4 align-items-end">
                    <div class="col-12 col-lg-4">
                        <p class="fs-5 mb-2"><strong>{{ totalItems }}</strong> article(s) au total</p>
                        <p class="fs-5 mb-0"><strong>{{ totalAmount|number_format(2, ',', ' ') }} €</strong></p>
                    </div>

                    <div class="col-12 col-lg-4">
                        <label for="promo-code" class="form-label fw-semibold">Code promotionnel</label>
                        <input
                            type="text"
                            id="promo-code"
                            class="form-control form-control-lg"
                            placeholder="Saisissez votre code promotionnel"
                        >
                    </div>

                    <div class="col-12 col-lg-4 text-lg-end">
                        <a href="{{ path('app_checkout_summary') }}" class="btn btn-primary btn-lg fw-semibold px-4">Passer la commande</a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
