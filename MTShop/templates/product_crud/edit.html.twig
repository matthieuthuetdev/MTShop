{% extends 'base.html.twig' %}

{% block title %}Modifier produit{% endblock %}

{% block body %}
<div class="container py-4">
    <h1>Modifier produit</h1>

    {{ form_start(productForm) }}
        <div class="row gy-3">
            <div class="col-12 col-md-6">{{ form_row(productForm.name) }}</div>
            <div class="col-12 col-md-6">{{ form_row(productForm.price) }}</div>
            <div class="col-12 col-md-6">{{ form_row(productForm.stock) }}</div>
            <div class="col-12">{{ form_row(productForm.description) }}</div>
        </div>

        <div class="mt-4">
            <button class="btn btn-primary">Mettre à jour</button>
            <a href="{{ path('product_crud_index') }}" class="btn btn-secondary">Retour</a>
        </div>
    {{ form_end(productForm) }}
</div>
{% endblock %}
