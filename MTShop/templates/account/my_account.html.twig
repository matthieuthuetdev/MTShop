{% extends 'base.html.twig' %}

{% block title %}Mon compte | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="display-5 fw-bold mb-2">Mon compte</h1>
                <p class="fs-5 text-secondary mb-0">Toutes vos informations personnelles sont regroupées ici.</p>
            </div>
            <div class="d-flex justify-content-md-end">
                <a href="{{ path('app_my_account_edit') }}" class="btn btn-primary btn-lg fw-semibold">Modifier mes informations</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm h-100" style="border-color: #0b1f3a !important;">
                    <h2 class="h3 fw-bold mb-3">Informations de base</h2>
                    <dl class="mb-0">
                        <div class="mb-3">
                            <dt class="text-secondary">Prénom</dt>
                            <dd class="mb-0 fs-5">{{ app.user.firstName }}</dd>
                        </div>
                        <div class="mb-3">
                            <dt class="text-secondary">Nom</dt>
                            <dd class="mb-0 fs-5">{{ app.user.lastName }}</dd>
                        </div>
                        <div class="mb-3">
                            <dt class="text-secondary">Date de naissance</dt>
                            <dd class="mb-0 fs-5">
                                {{ app.user.birthDate ? app.user.birthDate|date('d/m/Y') : 'Non renseignée' }}
                            </dd>
                        </div>
                        <div class="mb-0">
                            <dt class="text-secondary">Adresse mail</dt>
                            <dd class="mb-0 fs-5">{{ app.user.email }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm h-100" style="border-color: #0b1f3a !important;">
                    <h2 class="h3 fw-bold mb-3">Informations postales</h2>
                    <dl class="mb-0">
                        <div class="mb-3">
                            <dt class="text-secondary">Adresse de livraison</dt>
                            <dd class="mb-0 fs-5">{{ app.user.shippingAddress ?: 'Non renseignée' }}</dd>
                        </div>
                        <div class="mb-0">
                            <dt class="text-secondary">Adresse de facturation</dt>
                            <dd class="mb-0 fs-5">{{ app.user.billingAddress ?: 'Non renseignée' }}</dd>
                        </div>
                    </dl>
                </div>
            </div>

            <div class="col-12">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h2 class="h3 fw-bold mb-3">Moyens de paiement</h2>
                    <p class="fs-5 mb-0 text-secondary">Rien à afficher pour le moment.</p>
                </div>
            </div>

            <div class="col-12">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h2 class="h3 fw-bold mb-3">Double authentification</h2>
                    <p class="fs-5 mb-0 text-secondary">
                        {{ app.user.twoFactorEnabled ? 'La double authentification est activée.' : 'La double authentification est désactivée.' }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
