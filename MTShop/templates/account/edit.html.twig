{% extends 'base.html.twig' %}

{% block title %}Edit My Account | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Edit My Account</h1>
            <p class="fs-5 text-secondary mb-0">The forms for each section will be displayed here.</p>
        </div>

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
            <p class="fs-5 mb-0">This page is ready for the information groups: email, basic information, and postal address.</p>
        </div>
    </div>
</section>
{% endblock %}
