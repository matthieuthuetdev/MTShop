{% extends 'base.html.twig' %}

{% block title %}Modifier mes informations | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Modifier mes informations</h1>
            <p class="fs-5 text-secondary mb-0">Modifiez vos informations section par section.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;" id="email">
            <fieldset class="mb-0">
                <legend class="h3 fw-bold mb-4">Adresse mail</legend>
                <form method="post" action="{{ path('app_my_account_update_email') }}" class="d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_update_email') }}">
                    <div>
                        <label for="account-email" class="form-label fw-semibold">Adresse mail</label>
                        <input
                            type="email"
                            class="form-control form-control-lg"
                            id="account-email"
                            name="email"
                            value="{{ app.user.email }}"
                            autocomplete="email"
                            required
                        >
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">Modifier l'adresse mail</button>
                    </div>
                </form>
            </fieldset>
        </div>

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm mt-4" style="border-color: #0b1f3a !important;" id="basic-information">
            <fieldset class="mb-0">
                <legend class="h3 fw-bold mb-4">Informations de base</legend>
                <form method="post" action="{{ path('app_my_account_update_basic_information') }}" class="d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_update_basic_information') }}">
                    <div>
                        <label for="account-first-name" class="form-label fw-semibold">Prénom</label>
                        <input
                            type="text"
                            class="form-control form-control-lg"
                            id="account-first-name"
                            name="firstName"
                            value="{{ app.user.firstName }}"
                            autocomplete="given-name"
                            required
                        >
                    </div>
                    <div>
                        <label for="account-last-name" class="form-label fw-semibold">Nom</label>
                        <input
                            type="text"
                            class="form-control form-control-lg"
                            id="account-last-name"
                            name="lastName"
                            value="{{ app.user.lastName }}"
                            autocomplete="family-name"
                            required
                        >
                    </div>
                    <div>
                        <label for="account-birth-date" class="form-label fw-semibold">Date de naissance</label>
                        <input
                            type="date"
                            class="form-control form-control-lg"
                            id="account-birth-date"
                            name="birthDate"
                            value="{{ app.user.birthDate ? app.user.birthDate|date('Y-m-d') : '' }}"
                            autocomplete="bday"
                        >
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">Modifier les informations de base</button>
                    </div>
                </form>
            </fieldset>
        </div>

        {% set shippingAddressLines = app.user.shippingAddress ? app.user.shippingAddress|split('\n') : [] %}
        {% set shippingLine1 = shippingAddressLines[0] ?? '' %}
        {% set shippingPostalCity = shippingAddressLines[1] ?? '' %}
        {% set shippingPostalCode = shippingPostalCity ? shippingPostalCity|split(' ')|first : '' %}
        {% set shippingCity = shippingPostalCity ? shippingPostalCity|replace({(shippingPostalCode ~ ' '): ''}) : '' %}
        {% set shippingCountry = shippingAddressLines[2] ?? '' %}

        {% set billingAddressLines = app.user.billingAddress ? app.user.billingAddress|split('\n') : [] %}
        {% set billingLine1 = billingAddressLines[0] ?? '' %}
        {% set billingPostalCity = billingAddressLines[1] ?? '' %}
        {% set billingPostalCode = billingPostalCity ? billingPostalCity|split(' ')|first : '' %}
        {% set billingCity = billingPostalCity ? billingPostalCity|replace({(billingPostalCode ~ ' '): ''}) : '' %}
        {% set billingCountry = billingAddressLines[2] ?? '' %}
        {% set billingSame = app.user.billingAddress is empty or app.user.billingAddress == app.user.shippingAddress %}

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm mt-4" style="border-color: #0b1f3a !important;" id="address">
            <fieldset class="mb-0">
                <legend class="h3 fw-bold mb-4">Adresse postale</legend>
                <form id="account-address-form" method="post" action="{{ path('app_my_account_update_address') }}" class="d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_update_address') }}">

                    <div class="row g-3">
                        <div class="col-12">
                            <h2 class="h5 fw-semibold mb-3">Adresse de livraison</h2>
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="account-shipping-line1" class="form-label fw-semibold">Numéro et nom de rue</label>
                            <input
                                type="text"
                                class="form-control form-control-lg"
                                id="account-shipping-line1"
                                name="shippingLine1"
                                value="{{ shippingLine1 }}"
                                autocomplete="shipping street-address"
                                required
                            >
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="account-shipping-postal-code" class="form-label fw-semibold">Code postal</label>
                            <input
                                type="text"
                                class="form-control form-control-lg"
                                id="account-shipping-postal-code"
                                name="shippingPostalCode"
                                value="{{ shippingPostalCode }}"
                                autocomplete="shipping postal-code"
                                required
                            >
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="account-shipping-city" class="form-label fw-semibold">Ville</label>
                            <input
                                type="text"
                                class="form-control form-control-lg"
                                id="account-shipping-city"
                                name="shippingCity"
                                value="{{ shippingCity }}"
                                autocomplete="shipping address-level2"
                                required
                            >
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="account-shipping-country" class="form-label fw-semibold">Pays</label>
                            <input
                                type="text"
                                class="form-control form-control-lg"
                                id="account-shipping-country"
                                name="shippingCountry"
                                value="{{ shippingCountry }}"
                                autocomplete="shipping country-name"
                                required
                            >
                        </div>

                        <div class="col-12">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="billingSameAsShipping" id="billing-same" value="yes" {% if billingSame %}checked{% endif %}>
                                <label class="form-check-label" for="billing-same">Votre adresse de livraison et de facturation sont identiques</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="billingSameAsShipping" id="billing-different" value="no" {% if not billingSame %}checked{% endif %}>
                                <label class="form-check-label" for="billing-different">Elles sont différentes</label>
                            </div>
                        </div>

                        <div id="billing-address-fields" class="col-12 d-none">
                            <div class="row g-3">
                                <div class="col-12">
                                    <h2 class="h5 fw-semibold mb-3">Adresse de facturation</h2>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="account-billing-line1" class="form-label fw-semibold">Numéro et nom de rue</label>
                                    <input
                                        type="text"
                                        class="form-control form-control-lg"
                                        id="account-billing-line1"
                                        name="billingLine1"
                                        value="{{ billingLine1 }}"
                                        data-billing-field="line1"
                                        autocomplete="billing street-address"
                                    >
                                </div>
                                <div class="col-12 col-md-3">
                                    <label for="account-billing-postal-code" class="form-label fw-semibold">Code postal</label>
                                    <input
                                        type="text"
                                        class="form-control form-control-lg"
                                        id="account-billing-postal-code"
                                        name="billingPostalCode"
                                        value="{{ billingPostalCode }}"
                                        data-billing-field="postalCode"
                                        autocomplete="billing postal-code"
                                    >
                                </div>
                                <div class="col-12 col-md-3">
                                    <label for="account-billing-city" class="form-label fw-semibold">Ville</label>
                                    <input
                                        type="text"
                                        class="form-control form-control-lg"
                                        id="account-billing-city"
                                        name="billingCity"
                                        value="{{ billingCity }}"
                                        data-billing-field="city"
                                        autocomplete="billing address-level2"
                                    >
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="account-billing-country" class="form-label fw-semibold">Pays</label>
                                    <input
                                        type="text"
                                        class="form-control form-control-lg"
                                        id="account-billing-country"
                                        name="billingCountry"
                                        value="{{ billingCountry }}"
                                        data-billing-field="country"
                                        autocomplete="billing country-name"
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold">Modifier les adresses postales</button>
                        </div>
                    </div>
                </form>
            </fieldset>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const billingSame = document.getElementById('billing-same');
                const billingDifferent = document.getElementById('billing-different');
                const billingFields = document.getElementById('billing-address-fields');
                const accountForm = document.getElementById('account-address-form');

                const updateBillingVisibility = function () {
                    if (billingSame.checked) {
                        billingFields.classList.add('d-none');
                    } else {
                        billingFields.classList.remove('d-none');
                    }
                };

                billingSame.addEventListener('change', updateBillingVisibility);
                billingDifferent.addEventListener('change', updateBillingVisibility);
                updateBillingVisibility();

                accountForm.addEventListener('submit', function () {
                    if (billingSame.checked) {
                        const shippingLine1 = document.getElementById('account-shipping-line1').value;
                        const shippingPostalCode = document.getElementById('account-shipping-postal-code').value;
                        const shippingCity = document.getElementById('account-shipping-city').value;
                        const shippingCountry = document.getElementById('account-shipping-country').value;

                        document.getElementById('account-billing-line1').value = shippingLine1;
                        document.getElementById('account-billing-postal-code').value = shippingPostalCode;
                        document.getElementById('account-billing-city').value = shippingCity;
                        document.getElementById('account-billing-country').value = shippingCountry;
                    }
                });
            });
        </script>

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm mt-4" style="border-color: #0b1f3a !important;" id="two-factor">
            <fieldset class="mb-0">
                <legend class="h3 fw-bold mb-4">Double authentification</legend>
                <form method="post" action="{{ path('app_my_account_update_two_factor') }}" class="d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_update_two_factor') }}">
                    <div class="form-check">
                        <input
                            class="form-check-input"
                            type="radio"
                            name="twoFactorEnabled"
                            id="two-factor-enabled"
                            value="1"
                            {% if app.user.twoFactorEnabled %}checked{% endif %}
                        >
                        <label class="form-check-label fw-semibold" for="two-factor-enabled">
                            Activer (recommandé)
                        </label>
                    </div>
                    <div class="form-check">
                        <input
                            class="form-check-input"
                            type="radio"
                            name="twoFactorEnabled"
                            id="two-factor-disabled"
                            value="0"
                            {% if not app.user.twoFactorEnabled %}checked{% endif %}
                        >
                        <label class="form-check-label fw-semibold" for="two-factor-disabled">
                            Désactiver
                        </label>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">Modifier la double authentification</button>
                    </div>
                </form>
            </fieldset>
        </div>
    </div>
</section>
{% endblock %}
