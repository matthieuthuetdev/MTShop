{% extends 'base.html.twig' %}

{% block title %}Edit My Account | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Edit My Account</h1>
            <p class="fs-5 text-secondary mb-0">Update your information section by section.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
            <fieldset class="mb-0">
                <legend class="h3 fw-bold mb-4">Email</legend>
                <form method="post" action="{{ path('app_my_account_update_email') }}" class="d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_update_email') }}">
                    <div>
                        <label for="account-email" class="form-label fw-semibold">Email address</label>
                        <input
                            type="email"
                            class="form-control form-control-lg"
                            id="account-email"
                            name="email"
                            value="{{ app.user.email }}"
                            autocomplete="email"
                            required
                        >
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold">Update email</button>
                    </div>
                </form>
            </fieldset>
        </div>
    </div>
</section>
{% endblock %}
