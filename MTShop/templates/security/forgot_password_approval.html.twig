{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="rounded-4 bg-white border border-2 p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h1 class="display-5 fw-bold mb-3">Réinitialiser votre mot de passe</h1>
                    <p class="text-muted mb-4">Bonjour {{ user.firstName|default(user.email) }}, souhaitez-vous confirmer cette demande de réinitialisation ?</p>

                    <form method="post" action="{{ path('app_forgot_password_approval', {'token': token}) }}" class="auth-form">
                        <input type="hidden" name="decision" value="approve">
                        <button type="submit" class="btn btn-success btn-lg w-100 fw-semibold mb-3">Oui, réinitialiser mon mot de passe</button>
                    </form>

                    <form method="post" action="{{ path('app_forgot_password_approval', {'token': token}) }}" class="auth-form">
                        <input type="hidden" name="decision" value="reject">
                        <button type="submit" class="btn btn-outline-secondary btn-lg w-100 fw-semibold">Non, annuler</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
