{% extends 'base.html.twig' %}

{% block title %}Validation en attente | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="rounded-4 bg-white border border-2 p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h1 class="display-5 fw-bold mb-3">Validation en attente</h1>
                    <p class="text-muted mb-4">Nous attendons votre confirmation depuis l’e-mail reçu. Si vous avez déjà validé la demande, la page se mettra à jour automatiquement.</p>
                    <div class="alert alert-info" role="status">
                        Nous vérifions votre validation toutes les secondes. Si la demande est approuvée, le formulaire de nouveau mot de passe s’affichera automatiquement.
                    </div>
                    <script>
                        setTimeout(function () {
                            window.location.reload();
                        }, 1000);
                    </script>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
