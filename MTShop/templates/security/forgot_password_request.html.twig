{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="rounded-4 bg-white border border-2 p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h1 class="display-5 fw-bold mb-3">Mot de passe oublié</h1>
                    <p class="text-muted mb-4">Saisissez votre adresse e-mail. Si un compte existe, nous vous enverrons un lien sécurisé pour réinitialiser votre mot de passe.</p>

                    {% if successMessage %}
                        <div class="alert alert-success border border-success mb-4 fw-semibold" role="alert" style="font-size: 1.05rem;">
                            {{ successMessage }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_forgot_password_request') }}" class="auth-form" novalidate data-turbo="false">
                        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

                        <div class="mb-4">
                            <label for="inputEmail" class="auth-label mb-2">Adresse e-mail</label>
                            <input
                                type="email"
                                value="{{ email }}"
                                name="email"
                                id="inputEmail"
                                class="form-control form-control-lg auth-control"
                                placeholder="Entrez votre adresse e-mail"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">Envoyer le lien</button>
                    </form>

                    <div class="mt-4 text-center">
                        <a href="{{ path('app_login') }}" class="text-decoration-none fw-semibold">Retour à la connexion</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
