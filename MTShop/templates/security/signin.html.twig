{% extends 'base.html.twig' %}

{% block title %}Connexion | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="rounded-4 bg-white border border-2 p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h1 class="display-5 fw-bold mb-4">Se connecter</h1>

                    {% if error %}
                        <div class="alert alert-danger mb-4" role="alert">
                            {{ error }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}" class="auth-form" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('login') }}">

                        <div class="mb-3">
                            <label for="inputEmail" class="auth-label mb-2">Adresse mail</label>
                            <input
                                type="email"
                                value="{{ last_email }}"
                                name="email"
                                id="inputEmail"
                                class="form-control form-control-lg auth-control"
                                placeholder="Entrez votre adresse e-mail"
                                autocomplete="email"
                                required
                                autofocus
                            >
                        </div>

                        <div class="mb-4">
                            <label for="inputPassword" class="auth-label mb-2">Mot de passe</label>
                            <input
                                type="password"
                                name="password"
                                id="inputPassword"
                                class="form-control form-control-lg auth-control"
                                placeholder="Saisissez votre mot de passe"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">Se connecter</button>
                    </form>

                    <div class="mt-3 text-end">
                        <a href="{{ path('app_forgot_password_request') }}" class="text-decoration-none fw-semibold">Mot de passe oublié ?</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .auth-form {
        display: grid;
        gap: 1rem;
        width: 100%;
    }

    .auth-label {
        font-weight: 700;
    }

    .auth-control,
    .auth-control:focus {
        display: block;
        width: 100%;
        max-width: 100%;
        background: #ffffff;
        color: #212529;
        border: 1px solid rgba(11, 31, 58, 0.24);
        border-radius: 999px;
        box-shadow: inset 0 0 0 1px rgba(11, 31, 58, 0.03);
    }

    .auth-control::placeholder {
        color: rgba(33, 37, 41, 0.5);
    }

    .auth-control:focus {
        border-color: rgba(11, 31, 58, 0.55);
        box-shadow: 0 0 0 3px rgba(11, 31, 58, 0.08);
    }
</style>
{% endblock %}
