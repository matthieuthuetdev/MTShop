{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="rounded-4 bg-white border border-2 p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
                    <h1 class="display-5 fw-bold mb-3">Définir un nouveau mot de passe</h1>
                    <p class="text-muted mb-4">Choisissez un nouveau mot de passe fort pour sécuriser votre compte.</p>

                    {% if error %}
                        <div class="alert alert-danger mb-4" role="alert">
                            {{ error }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_forgot_password_update', {'token': token}) }}" class="auth-form" novalidate>
                        <div class="mb-3">
                            <label for="inputPassword" class="auth-label mb-2">Nouveau mot de passe</label>
                            <input type="password" name="password" id="inputPassword" class="form-control form-control-lg auth-control" placeholder="Saisissez un nouveau mot de passe" required>
                        </div>

                        <div class="mb-4">
                            <label for="inputConfirmPassword" class="auth-label mb-2">Confirmer le mot de passe</label>
                            <input type="password" name="confirm_password" id="inputConfirmPassword" class="form-control form-control-lg auth-control" placeholder="Confirmez votre mot de passe" required>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">Enregistrer le nouveau mot de passe</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
