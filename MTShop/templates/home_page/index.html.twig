{% extends 'base.html.twig' %}

{% block title %}Accueil | MTShop{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="px-4 py-5 py-md-6 bg-light border rounded-4">
        <h1 class="display-3 fw-bold mb-4">MTShop</h1>
        <div class="row g-4" style="max-width: 1100px;">
            <div class="col-12 col-lg-6">
                <article class="h-100 bg-white border rounded-4 p-4 p-md-5 shadow-sm">
                    <h2 class="h3 fw-bold mb-3">Boutique factice</h2>
                    <p class="lead mb-0">
                        Cette boutique en ligne est une boutique factice conçue uniquement pour des tests.
                        L'intégralité des paiements effectués sera remboursée.
                    </p>
                </article>
            </div>
            <div class="col-12 col-lg-6">
                <article class="h-100 bg-white border rounded-4 p-4 p-md-5 shadow-sm">
                    <h2 class="h3 fw-bold mb-3">Développer de nouvelles compétences</h2>
                    <p class="lead mb-0">
                        Ce projet a pour but de me faire acquérir de nouvelles compétences,
                        comme l'acceptation de paiements et la création d'un site sécurisé.
                    </p>
                </article>
            </div>
        </div>
        <div class="mt-4 text-center">
            <a class="btn btn-primary btn-lg px-4 py-3 fw-semibold" href="#">Commencer vos achats</a>
        </div>
    </div>
</section>

<section class="container pb-5">
    <div class="mb-4">
        <h2 class="display-6 fw-bold mb-2">Nos meilleures offres</h2>
        <p class="text-secondary mb-0">Une sélection de produits de démonstration pour tester le rendu de la boutique.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4">
            <article class="h-100 bg-white border border-2 rounded-4 shadow-sm overflow-hidden" style="border-color: #0b1f3a !important;">
                <div class="w-100 bg-primary" style="height: 240px;"></div>
                <div class="p-4">
                    <h3 class="h4 fw-bold mb-2">Produit 1</h3>
                    <p class="text-secondary mb-4">Une fiche produit d'exemple pour visualiser une carte claire, moderne et facile à lire.</p>
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <strong class="fs-5">24,90 €</strong>
                        <div class="d-flex align-items-center gap-2" data-cart-controls>
                            <button type="button" class="btn btn-danger d-none" data-action="remove">Retirer du panier</button>
                            <span class="fw-semibold d-none" data-quantity>0</span>
                            <button type="button" class="btn btn-primary" data-action="add">Ajouter au panier</button>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <article class="h-100 bg-white border border-2 rounded-4 shadow-sm overflow-hidden" style="border-color: #0b1f3a !important;">
                <div class="w-100 bg-primary" style="height: 240px;"></div>
                <div class="p-4">
                    <h3 class="h4 fw-bold mb-2">Produit 2</h3>
                    <p class="text-secondary mb-4">Ce deuxième produit permet de tester l'affichage de plusieurs cartes avec le même comportement.</p>
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <strong class="fs-5">39,90 €</strong>
                        <div class="d-flex align-items-center gap-2" data-cart-controls>
                            <button type="button" class="btn btn-danger d-none" data-action="remove">Retirer du panier</button>
                            <span class="fw-semibold d-none" data-quantity>0</span>
                            <button type="button" class="btn btn-primary" data-action="add">Ajouter au panier</button>
                        </div>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <article class="h-100 bg-white border border-2 rounded-4 shadow-sm overflow-hidden" style="border-color: #0b1f3a !important;">
                <div class="w-100 bg-primary" style="height: 240px;"></div>
                <div class="p-4">
                    <h3 class="h4 fw-bold mb-2">Produit 3</h3>
                    <p class="text-secondary mb-4">Une troisième carte pour préparer une future grille produits avec panier, prix et interactions.</p>
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <strong class="fs-5">54,90 €</strong>
                        <div class="d-flex align-items-center gap-2" data-cart-controls>
                            <button type="button" class="btn btn-danger d-none" data-action="remove">Retirer du panier</button>
                            <span class="fw-semibold d-none" data-quantity>0</span>
                            <button type="button" class="btn btn-primary" data-action="add">Ajouter au panier</button>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll('[data-cart-controls]').forEach((controls) => {
        const addButton = controls.querySelector('[data-action="add"]');
        const removeButton = controls.querySelector('[data-action="remove"]');
        const quantity = controls.querySelector('[data-quantity]');
        let count = 0;

        const render = () => {
            quantity.textContent = String(count);

            if (count > 0) {
                removeButton.classList.remove('d-none');
                quantity.classList.remove('d-none');
            } else {
                removeButton.classList.add('d-none');
                quantity.classList.add('d-none');
            }
        };

        addButton.addEventListener('click', () => {
            count += 1;
            render();
        });

        removeButton.addEventListener('click', () => {
            if (count > 0) {
                count -= 1;
            }

            render();
        });
    });
</script>
{% endblock %}
