<div class="row g-3">
    <div class="col-12 col-lg-6">{{ form_row(productForm.name) }}</div>
    <div class="col-12 col-lg-6">{{ form_row(productForm.category) }}</div>
    <div class="col-12">{{ form_row(productForm.description) }}</div>
    <div class="col-12 col-md-4">{{ form_row(productForm.price) }}</div>
    <div class="col-12 col-md-4">{{ form_row(productForm.stock) }}</div>
    <div class="col-12 col-md-4">{{ form_row(productForm.promotion) }}</div>
    <div class="col-12 col-md-6">{{ form_row(productForm.imageFile) }}</div>
    <div class="col-12 col-md-6 d-flex align-items-center">{{ form_row(productForm.isActive) }}</div>
</div>
