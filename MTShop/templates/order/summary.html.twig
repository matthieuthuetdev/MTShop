{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de commande | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Récapitulatif de commande</h1>
            <p class="fs-5 text-secondary mb-0">Vérifiez vos informations et choisissez votre mode de livraison avant de commander et payer.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm h-100" style="border-color: #0b1f3a !important;">
                    <h2 class="h4 fw-bold mb-4">Vos informations</h2>

                    {% if not hasRequiredAddresses %}
                        <div class="alert alert-warning mb-4" role="alert">
                            Vous devez compléter vos adresses avant de pouvoir passer la commande.
                        </div>
                    {% endif %}

                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                            <h3 class="h5 fw-bold mb-0">Adresse de livraison</h3>
                            <a href="{{ path('app_my_account_edit') }}#address" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                        <p class="mb-0">{{ shippingAddress ?: 'Non renseignée' }}</p>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                            <h3 class="h5 fw-bold mb-0">Adresse de facturation</h3>
                            <a href="{{ path('app_my_account_edit') }}#address" class="btn btn-outline-primary btn-sm">Modifier</a>
                        </div>
                        <p class="mb-0">{{ billingAddress ?: 'Non renseignée' }}</p>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                            <h3 class="h5 fw-bold mb-0">Moyen de paiement</h3>
                            <span class="btn btn-outline-secondary btn-sm disabled">Modifier</span>
                        </div>
                        <p class="mb-0">Non disponible</p>
                    </div>

                    <form method="post" action="{{ path('app_checkout_place') }}" class="d-grid gap-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('checkout_place') }}">

                        <div class="rounded-4 border border-2 p-4" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                <h3 class="h5 fw-bold mb-0">Choisissez votre offre de livraison</h3>
                                <a href="#delivery-options" class="btn btn-outline-primary btn-sm">Modifier</a>
                            </div>

                            <div class="d-grid gap-3" id="delivery-options">
                                {% for option in deliveryOptions %}
                                    <label class="rounded-4 border border-2 p-3 d-grid gap-1" style="border-color: rgba(11, 31, 58, 0.12) !important;">
                                        <div class="d-flex align-items-start gap-3">
                                            <input
                                                type="radio"
                                                name="delivery_method"
                                                value="{{ option.code }}"
                                                class="form-check-input mt-1"
                                                {% if option.code == selectedDelivery %}checked{% endif %}
                                                {% if not option.available %}disabled{% endif %}
                                            >
                                            <div>
                                                <div class="fw-bold">{{ option.label }} - {{ option.fee > 0 ? option.fee|number_format(2, ',', ' ') ~ ' €' : 'Offerte' }}</div>
                                                <div class="text-secondary">{{ option.description }}</div>
                                                <div class="text-secondary">{{ option.note }}</div>
                                                <div class="text-secondary">Livraison estimée : {{ option.estimate }}</div>
                                                {% if not option.available %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                            <h3 class="h5 fw-bold mb-3">Récapitulatif</h3>
                            <p class="mb-1"><strong>{{ totalItems }}</strong> article(s)</p>
                            <p class="mb-1">Sous-total : <strong>{{ subtotal|number_format(2, ',', ' ') }} €</strong></p>
                            <p class="mb-0 text-secondary">Le montant final sera calculé avec l’offre de livraison choisie.</p>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg fw-semibold" {% if not hasRequiredAddresses %}disabled{% endif %}>Commander et payer</button>
                    </form>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm h-100" style="border-color: #0b1f3a !important;">
                    <h2 class="h4 fw-bold mb-4">Articles</h2>

                    {% if items is empty %}
                        <p class="text-secondary mb-0">Votre panier est vide.</p>
                    {% else %}
                        <div class="d-grid gap-3">
                            {% for item in items %}
                                <div class="d-flex gap-3 align-items-start justify-content-between">
                                    <div class="rounded-4 bg-primary" style="width: 80px; height: 80px;"></div>
                                    <div>
                                        <div class="fw-bold">{{ item.product.name }}</div>
                                        <div class="text-secondary">{{ item.quantity }} × {{ item.discountedUnitPrice|number_format(2, ',', ' ') }} €</div>
                                        <div class="text-secondary">Total ligne : {{ item.lineTotal|number_format(2, ',', ' ') }} €</div>
                                    </div>
                                    <a href="{{ path('app_cart_index') }}" class="btn btn-outline-primary btn-sm">Modifier</a>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
