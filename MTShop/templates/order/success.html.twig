{% extends 'base.html.twig' %}

{% block title %}Paiement en cours | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="rounded-4 border border-2 bg-white p-4 p-md-5 shadow-sm" style="border-color: #0b1f3a !important;">
            <h1 class="display-5 fw-bold mb-3">Paiement reçu</h1>

            {% if isPaymentConfirmed %}
                <p class="fs-5 text-secondary mb-4">Votre paiement a été confirmé. Votre commande est maintenant enregistrée.</p>
                <div class="d-flex flex-column flex-md-row gap-3">
                    <a href="{{ path('app_order_confirmation', {id: order.id}) }}" class="btn btn-primary btn-lg fw-semibold">Voir la confirmation</a>
                    <a href="{{ path('app_orders_index') }}" class="btn btn-outline-primary btn-lg fw-semibold">Voir mes commandes</a>
                </div>
            {% else %}
                <p class="fs-5 text-secondary mb-4">Nous avons bien reçu votre retour depuis Stripe. La confirmation finale du paiement est en cours de vérification.</p>
                <div class="alert alert-info mb-4" role="alert">
                    Cette page ne valide pas le paiement à elle seule. La commande sera confirmée dès réception du webhook Stripe.
                </div>
                <div class="d-flex flex-column flex-md-row gap-3">
                    <a href="{{ path('app_checkout_success', {id: order.id}) }}" class="btn btn-primary btn-lg fw-semibold">Actualiser le statut</a>
                    <a href="{{ path('app_orders_index') }}" class="btn btn-outline-primary btn-lg fw-semibold">Voir mes commandes</a>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
