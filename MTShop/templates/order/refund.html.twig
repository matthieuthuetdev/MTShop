{% extends 'base.html.twig' %}

{% block title %}Demande de remboursement | MTShop{% endblock %}

{% block body %}
<section class="bg-white py-5" style="min-height: calc(100vh - 72px);">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold mb-2">Demander un remboursement</h1>
            <p class="fs-5 text-secondary mb-0">Sélectionnez les articles de la commande #{{ order.id }} et précisez la raison pour chacun.</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mb-4" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm" style="border-color: #0b1f3a !important;">
                    <form method="post" action="{{ path('app_order_refund', {id: order.id}) }}" class="d-grid gap-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('refund_order_' ~ order.id) }}">

                        {% for item in refundItems %}
                            {% set orderItem = item.orderItem %}
                            {% set product = item.product %}
                            <article class="rounded-4 border border-2 p-4" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                        <div class="form-check">
                                            <input
                                                class="form-check-input js-refund-checkbox"
                                                type="checkbox"
                                                value="1"
                                                id="refund-item-{{ orderItem.id }}"
                                                name="items[{{ orderItem.id }}]"
                                                data-target="#refund-reason-{{ orderItem.id }}"
                                            >
                                            <label class="form-check-label" for="refund-item-{{ orderItem.id }}">
                                                <span class="fw-bold d-block">{{ product ? product.name : 'Produit indisponible' }}</span>
                                                <span class="text-secondary d-block">{{ item.quantity }} article(s) - {{ item.lineTotal|number_format(2, ',', ' ') }} €</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div id="refund-reason-{{ orderItem.id }}" class="d-none">
                                        <label for="refund-text-{{ orderItem.id }}" class="form-label fw-semibold">Raison de la demande</label>
                                        <textarea
                                            id="refund-text-{{ orderItem.id }}"
                                            name="reasons[{{ orderItem.id }}]"
                                            class="form-control rounded-4 border border-2 shadow-sm"
                                            style="border-color: rgba(11, 31, 58, 0.16) !important; min-height: 120px;"
                                            placeholder="Expliquez pourquoi vous demandez un remboursement pour cet article."
                                        ></textarea>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <a href="{{ path('app_orders_index') }}" class="btn btn-outline-secondary btn-lg">Retour à mes commandes</a>
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold">Envoyer la demande</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="rounded-4 border border-2 bg-white p-4 shadow-sm h-100" style="border-color: #0b1f3a !important;">
                    <h2 class="h4 fw-bold mb-4">Résumé de la commande</h2>
                    <div class="d-grid gap-3">
                        <div class="rounded-4 border border-2 p-3" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="text-secondary small mb-1">Numéro</div>
                            <div class="fw-bold">#{{ order.id }}</div>
                        </div>
                        <div class="rounded-4 border border-2 p-3" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="text-secondary small mb-1">Statut</div>
                            <div class="fw-bold">{{ statusLabel }}</div>
                        </div>
                        <div class="rounded-4 border border-2 p-3" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="text-secondary small mb-1">Montant total</div>
                            <div class="fw-bold">{{ order.totalAmount|number_format(2, ',', ' ') }} €</div>
                        </div>
                        <div class="rounded-4 border border-2 p-3" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="text-secondary small mb-1">Nombre d'articles</div>
                            <div class="fw-bold">{{ totalItems }}</div>
                        </div>
                        <div class="rounded-4 border border-2 p-3" style="border-color: rgba(11, 31, 58, 0.16) !important;">
                            <div class="text-secondary small mb-1">Date de commande</div>
                            <div class="fw-bold">{{ order.createdAt ? order.createdAt|date('d/m/Y') : '—' }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.js-refund-checkbox').forEach(function (checkbox) {
            const targetSelector = checkbox.getAttribute('data-target');
            const reasonBox = targetSelector ? document.querySelector(targetSelector) : null;
            const textarea = reasonBox ? reasonBox.querySelector('textarea') : null;

            const syncVisibility = function () {
                if (!reasonBox) {
                    return;
                }

                reasonBox.classList.toggle('d-none', !checkbox.checked);

                if (textarea) {
                    textarea.required = checkbox.checked;
                    if (!checkbox.checked) {
                        textarea.value = '';
                    }
                }
            };

            checkbox.addEventListener('change', syncVisibility);
            syncVisibility();
        });
    });
</script>
{% endblock %}
