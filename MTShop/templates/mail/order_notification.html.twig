<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouvelle commande MTShop</title>
</head>
<body style="margin:0; padding:0; background-color:#f5f7fb; font-family:Arial, Helvetica, sans-serif; color:#0b1f3a;">
    <div style="max-width:720px; margin:0 auto; padding:32px 16px;">
        <div style="background-color:#ffffff; border:2px solid #0b1f3a; border-radius:20px; padding:32px;">
            <h1 style="margin:0 0 20px 0; font-size:28px;">Nouvelle commande MTShop</h1>

            <p style="margin:0 0 12px 0;">Une commande vient d'être passée.</p>

            <h2 style="margin:24px 0 12px 0; font-size:20px;">Client</h2>
            <p style="margin:0 0 6px 0;">Nom : {{ customer.firstName }} {{ customer.lastName }}</p>
            <p style="margin:0 0 6px 0;">Adresse mail : {{ customer.email }}</p>
            <p style="margin:0 0 6px 0;">Adresse de livraison : {{ order.shippingAddress }}</p>
            <p style="margin:0 0 6px 0;">Adresse de facturation : {{ order.billingAddress }}</p>

            <h2 style="margin:24px 0 12px 0; font-size:20px;">Livraison</h2>
            <p style="margin:0 0 6px 0;">Mode : {{ deliveryOption.label }}</p>
            <p style="margin:0 0 6px 0;">Frais : {{ deliveryOption.fee|number_format(2, ',', ' ') }} €</p>
            <p style="margin:0 0 6px 0;">Estimation : {{ deliveryOption.estimate }}</p>

            <h2 style="margin:24px 0 12px 0; font-size:20px;">Produits</h2>
            <ul style="margin:0; padding-left:20px;">
                {% for item in items %}
                    <li style="margin-bottom:10px;">
                        {{ item.product.name }} - {{ item.quantity }} × {{ item.discountedUnitPrice|number_format(2, ',', ' ') }} € = {{ item.lineTotal|number_format(2, ',', ' ') }} €
                    </li>
                {% endfor %}
            </ul>

            <p style="margin:24px 0 0 0; font-size:18px; font-weight:bold;">Total : {{ grandTotal|number_format(2, ',', ' ') }} €</p>
        </div>
    </div>
</body>
</html>
