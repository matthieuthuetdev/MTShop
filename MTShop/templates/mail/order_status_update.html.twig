<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mise à jour de commande MTShop</title>
</head>
<body style="margin:0; padding:0; background-color:#f5f7fb; font-family:Arial, Helvetica, sans-serif; color:#0b1f3a;">
    <div style="max-width:720px; margin:0 auto; padding:32px 16px;">
        <div style="background-color:#ffffff; border:2px solid #0b1f3a; border-radius:20px; padding:32px;">
            <h1 style="margin:0 0 20px 0; font-size:28px;">Mise à jour de votre commande MTShop</h1>

            <p style="margin:0 0 12px 0;">Bonjour {{ customer.firstName }},</p>
            <p style="margin:0 0 12px 0;">Le statut de votre commande <strong>#{{ order.id }}</strong> a été mis à jour.</p>

            <h2 style="margin:24px 0 12px 0; font-size:20px;">Nouveau statut</h2>
            <p style="margin:0 0 6px 0;">{{ statusLabel }}</p>

            <h2 style="margin:24px 0 12px 0; font-size:20px;">Récapitulatif</h2>
            <p style="margin:0 0 6px 0;">Numéro de commande : #{{ order.id }}</p>
            <p style="margin:0 0 6px 0;">Date de commande : {{ order.createdAt ? order.createdAt|date('d/m/Y') : '—' }}</p>
            <p style="margin:0 0 6px 0;">Montant total : {{ order.totalAmount|number_format(2, ',', ' ') }} €</p>

            {% if reason %}
                <h2 style="margin:24px 0 12px 0; font-size:20px;">Message du vendeur</h2>
                <p style="margin:0 0 6px 0;">{{ reason|nl2br }}</p>
            {% endif %}
        </div>
    </div>
</body>
</html>
