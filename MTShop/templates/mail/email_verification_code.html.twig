<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Code de validation MTShop</title>
    </head>
    <body style="margin:0; padding:0; background-color:#f5f7fb; font-family:Arial, Helvetica, sans-serif; color:#0b1f3a;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f5f7fb; padding:40px 16px;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:620px; background-color:#ffffff; border:2px solid #0b1f3a; border-radius:20px; overflow:hidden;">
                        <tr>
                            <td style="padding:32px 32px 12px 32px;">
                                <h1 style="margin:0 0 18px 0; font-size:28px; line-height:1.2; color:#0b1f3a;">Bonjour,</h1>
                                <p style="margin:0 0 20px 0; font-size:18px; line-height:1.6; color:#334155;">
                                    votre code de vérification est
                                </p>
                                <div style="margin:0 0 24px 0; padding:18px 20px; text-align:center; border:2px solid #0b1f3a; border-radius:16px;">
                                    <span style="display:block; font-size:42px; font-weight:700; letter-spacing:6px; color:#0b1f3a;">{{ code }}</span>
                                </div>
                                <p style="margin:0 0 14px 0; font-size:18px; line-height:1.6; color:#334155;">
                                    Il est valable 10 minutes.
                                </p>
                                <p style="margin:0 0 14px 0; font-size:18px; line-height:1.6; color:#b91c1c; font-weight:700;">
                                    Ne le communiquez sous aucun prétexte à un tiers.
                                </p>
                                <p style="margin:0; font-size:16px; line-height:1.6; color:#475569;">
                                    Pour votre sécurité, vérifiez toujours que vous êtes bien sur le site MTShop avant de saisir ce code.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
